---
export const prerender = false;
// The mount path, so the script can reach the API wherever Webflow Cloud serves the app.
const base = Astro.url.pathname.replace(/\/+$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>AI &amp; SEO readiness check</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=42dot+Sans:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <div id="qds-audit" data-base={base} data-state="form">
      <section class="panel" data-panel="form" aria-labelledby="qa-form-label">
        <p class="label" id="qa-form-label">First report</p>
        <form id="qa-form" novalidate>
          <div class="field">
            <label class="label" for="qa-url">Website URL</label>
            <input id="qa-url" name="url" type="text" inputmode="url" autocomplete="url" placeholder="https://yoursite.com" required />
          </div>
          <div class="field">
            <label class="label" for="qa-email">Work email</label>
            <input id="qa-email" name="email" type="email" autocomplete="email" placeholder="name@company.com" required />
          </div>
          <p class="error" id="qa-error" role="alert" hidden></p>
          <button class="btn" type="submit">
            <span>Check my site</span>
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12 12 2M5 2h7v7"></path></svg>
          </button>
          <p class="note">Up to 150 pages are checked. It takes about a minute. Your report opens here as a PDF.</p>
        </form>
      </section>

      <section class="panel" data-panel="run" aria-labelledby="qa-run-label" hidden>
        <p class="label" id="qa-run-label">Checking</p>
        <h2 class="host" id="qa-host"></h2>
        <div class="count" role="status">
          <span class="big" id="qa-done">0</span>
          <span class="of" id="qa-of"></span>
        </div>
        <div class="bar" id="qa-bar" role="progressbar" aria-label="Pages checked" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="fill" id="qa-fill"></div>
          <div class="sweep" aria-hidden="true"></div>
        </div>
        <p class="label sec">Steps</p>
        <ol class="steps" id="qa-steps">
          <li data-step="find"><span class="ic"></span><span class="tx"><span class="t">Reading your home page</span><span class="s">Waiting</span></span></li>
          <li data-step="read"><span class="ic"></span><span class="tx"><span class="t">Reading pages</span><span class="s">Waiting</span></span></li>
          <li data-step="write"><span class="ic"></span><span class="tx"><span class="t">Writing your report</span><span class="s">Waiting</span></span></li>
        </ol>
        <p class="label sec">Found so far</p>
        <ul class="found" id="qa-found" aria-live="polite"></ul>
      </section>

      <section class="panel" data-panel="done" aria-labelledby="qa-done-label" hidden>
        <p class="label" id="qa-done-label"></p>
        <h2 class="headline" id="qa-headline"></h2>
        <p class="sub" id="qa-sub"></p>
        <ul class="strip" id="qa-strip"></ul>
        <a class="btn" id="qa-pdf" href="#" target="_blank" rel="noopener" download>
          <span>Open your report (PDF)</span>
          <svg aria-hidden="true" width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12 12 2M5 2h7v7"></path></svg>
        </a>
        <button class="again" id="qa-again" type="button">Check another site</button>
      </section>
    </div>

    <script>
      import { makePdf } from "../lib/pdf";
      import type { PageRec, Report, StartResponse } from "../lib/types";

      const CAP = 150, BATCH = 25;
      const root = document.getElementById("qds-audit")!;
      const base = root.dataset.base ?? "";
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const show = (s: "form" | "run" | "done") => {
        root.dataset.state = s;
        root.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== s));
        sendHeight();
      };
      const sendHeight = () => {
        if (window.parent !== window) window.parent.postMessage({ type: "qds-audit-height", height: Math.ceil(root.getBoundingClientRect().height) + 2 }, "*");
      };
      new ResizeObserver(sendHeight).observe(root);

      async function api<T>(path: string, body: unknown): Promise<T> {
        const res = await fetch(`${base}/api/${path}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error((data as { error?: string }).error ?? "Something went wrong. Try again.");
        return data as T;
      }

      const ICON = {
        done: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#7DD98A" stroke-width="1.6"><circle cx="10" cy="10" r="8.5"/><path d="M6 10.5l2.7 2.7L14 7.5"/></svg>',
        run: '<span class="pulse"></span>',
        wait: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#4A505A" stroke-width="1.6"><circle cx="10" cy="10" r="8.5"/></svg>',
      };
      function step(name: string, state: "wait" | "run" | "done", sub: string) {
        const li = root.querySelector<HTMLElement>(`[data-step="${name}"]`)!;
        li.dataset.state = state;
        li.querySelector(".ic")!.innerHTML = ICON[state];
        li.querySelector(".s")!.textContent = sub;
      }

      const LV = { risk: "At risk", review: "Review", good: "Good" } as const;
      let pdfUrl: string | null = null;

      function renderFound(r: Report) {
        const ul = $("qa-found");
        ul.replaceChildren();
        const bad = r.areas.filter((a) => a.level !== "good").sort((a, b) => (a.level === b.level ? 0 : a.level === "risk" ? -1 : 1));
        for (const a of bad.slice(0, 3)) {
          const li = document.createElement("li");
          li.dataset.level = a.level;
          const dot = document.createElement("span");
          dot.className = "dot";
          dot.setAttribute("aria-hidden", "true");
          li.append(dot, a.items[0] ?? `${a.stat} ${a.caption}`);
          ul.append(li);
        }
      }

      function renderDone(r: Report) {
        $("qa-done-label").textContent = `First report · ${r.host} · ${r.date}`;
        $("qa-headline").textContent = r.headline;
        $("qa-sub").textContent = r.sub;
        const strip = $("qa-strip");
        strip.replaceChildren();
        for (const a of r.areas) {
          const li = document.createElement("li");
          li.dataset.level = a.level;
          const bar = document.createElement("span");
          bar.className = "tick";
          bar.setAttribute("aria-hidden", "true");
          const n = document.createElement("span");
          n.className = "label";
          n.textContent = `${a.n} · ${a.name}`;
          const l = document.createElement("span");
          l.className = "lv";
          l.textContent = LV[a.level];
          li.append(bar, n, l);
          strip.append(li);
        }
      }

      async function crawl(url: string, email: string) {
        show("run");
        $("qa-host").textContent = url.replace(/^https?:\/\//i, "").replace(/\/.*$/, "");
        $("qa-done").textContent = "0";
        $("qa-of").textContent = "";
        $("qa-found").replaceChildren();
        step("find", "run", "Working");
        step("read", "wait", "Waiting");
        step("write", "wait", "Waiting");

        const start = await api<StartResponse>("start", { url, email });
        $("qa-host").textContent = start.site.host;
        const sitemapSet = new Set(start.sitemapUrls);
        const known = new Set<string>([...start.sitemapUrls, ...start.seeds]);
        const queue = [...start.seeds];
        const queued = new Set(queue);
        const done: PageRec[] = [];
        step("find", "done", start.site.sitemap.found ? `Sitemap lists ${start.site.sitemap.count.toLocaleString("en-US")} pages` : "No sitemap found, following links");

        const paint = () => {
          const target = Math.min(CAP, Math.max(known.size, done.length + queue.length, 1));
          const pct = Math.min(100, Math.round((done.length / target) * 100));
          $("qa-done").textContent = String(done.length);
          $("qa-of").textContent = `of ${target.toLocaleString("en-US")} pages`;
          $("qa-fill").style.width = pct + "%";
          $("qa-bar").setAttribute("aria-valuenow", String(pct));
          step("read", "run", `${done.length} of ${target.toLocaleString("en-US")} checked`);
        };
        step("read", "run", "Starting");
        paint();

        while (queue.length && done.length < CAP) {
          const batch = queue.splice(0, Math.min(BATCH, CAP - done.length));
          let pages: PageRec[];
          try {
            pages = (await api<{ pages: PageRec[] }>("pages", { origin: start.site.origin, urls: batch })).pages;
          } catch {
            try { pages = (await api<{ pages: PageRec[] }>("pages", { origin: start.site.origin, urls: batch })).pages; }
            catch { pages = []; }
          }
          for (const p of pages) {
            p.inSitemap = sitemapSet.has(p.url);
            done.push(p);
            for (const l of p.links) {
              known.add(l);
              if (!queued.has(l) && done.length + queue.length < CAP) { queue.push(l); queued.add(l); }
            }
          }
          paint();
          if (done.length && queue.length) {
            api<Report>("report", { site: start.site, pages: done, known: known.size }).then(renderFound).catch(() => {});
          }
        }
        if (!done.some((p) => p.html && p.status < 400)) throw new Error("We could not read any page on this site. Check the address and try again.");

        step("read", "done", `${done.length} pages checked`);
        step("write", "run", "Almost done");
        const report = await api<Report>("report", { site: start.site, pages: done, known: Math.max(start.known, known.size) });
        const bytes = await makePdf(report);
        if (pdfUrl) URL.revokeObjectURL(pdfUrl);
        pdfUrl = URL.createObjectURL(new Blob([bytes as BlobPart], { type: "application/pdf" }));
        const link = $<HTMLAnchorElement>("qa-pdf");
        link.href = pdfUrl;
        link.download = `ai-seo-readiness-${report.host}.pdf`;
        step("write", "done", "Ready");
        renderDone(report);
        show("done");
      }

      const form = $<HTMLFormElement>("qa-form");
      const err = $("qa-error");
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        err.hidden = true;
        const url = $<HTMLInputElement>("qa-url").value.trim();
        const email = $<HTMLInputElement>("qa-email").value.trim();
        if (!url) { err.textContent = "Enter your website address."; err.hidden = false; return; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { err.textContent = "Enter a valid work email."; err.hidden = false; return; }
        try {
          await crawl(url, email);
        } catch (ex) {
          show("form");
          err.textContent = ex instanceof Error ? ex.message : "Something went wrong. Try again.";
          err.hidden = false;
          sendHeight();
        }
      });
      $("qa-again").addEventListener("click", () => { show("form"); $<HTMLInputElement>("qa-url").focus(); });
      show("form");
    </script>

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; background: #000; color: #fff; }
      body { font-family: "42dot Sans", Arial, sans-serif; font-size: 16px; line-height: 1.5; padding: 16px; }
      #qds-audit { max-width: 640px; margin: 0 auto; background: #16181c; border: 1px solid #24272e; }
      .panel { display: flex; flex-direction: column; gap: 24px; padding: 40px; }
      .panel[hidden] { display: none; }
      .label { margin: 0; font-family: "Geist Mono", monospace; font-size: 11px; line-height: 1.3; letter-spacing: 0.14em; text-transform: uppercase; color: #a8aeba; }
      .field { display: flex; flex-direction: column; gap: 8px; }
      form { display: flex; flex-direction: column; gap: 24px; }
      input { width: 100%; height: 52px; padding: 0 16px; background: #000; color: #fff; border: 1px solid #4a505a; border-radius: 0; font: inherit; font-size: 16px; }
      input::placeholder { color: #7c8493; }
      a:focus-visible, input:focus-visible, button:focus-visible { outline: 2px solid #dce2ff; outline-offset: 3px; }
      .btn { display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 0 20px; background: #3d5afe; color: #fff; border: 0; border-radius: 0; font: inherit; font-size: 17px; text-decoration: none; cursor: pointer; }
      .btn:hover { opacity: 0.88; }
      .note { margin: 0; font-size: 14px; line-height: 1.5; color: #a8aeba; }
      .error { margin: 0; padding: 12px 14px; border-left: 4px solid #c8352b; background: #000; font-size: 15px; color: #fff; }
      .error[hidden] { display: none; }
      .host { margin: 0; font-size: clamp(1.9rem, 6vw, 2.8rem); line-height: 1.05; font-weight: 500; letter-spacing: -0.03em; overflow-wrap: anywhere; }
      .count { display: flex; align-items: baseline; gap: 12px; }
      .big { font-size: 56px; line-height: 1; font-weight: 500; letter-spacing: -0.03em; }
      .of { font-size: 18px; color: #cdd2da; }
      .bar { position: relative; overflow: hidden; height: 6px; background: #24272e; }
      .fill { width: 0; height: 6px; background: #3d5afe; transition: width 0.4s ease; }
      .sweep { position: absolute; top: 0; left: 0; width: 18%; height: 6px; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.55), transparent); animation: sweep 1.6s linear infinite; }
      .sec { margin-bottom: -12px; }
      .steps, .found, .strip { margin: 0; padding: 0; list-style: none; }
      .steps { border-bottom: 1px solid #24272e; }
      .steps li { display: flex; gap: 16px; align-items: flex-start; padding: 14px 0; border-top: 1px solid #24272e; }
      .steps .ic { flex: none; display: block; width: 20px; height: 20px; }
      .steps .ic svg { display: block; }
      .steps .tx { display: flex; flex-direction: column; gap: 2px; }
      .steps .t { font-size: 17px; }
      .steps .s { font-size: 14px; color: #a8aeba; }
      .steps li[data-state="wait"] .t { color: #a8aeba; }
      .pulse { display: block; width: 12px; height: 12px; margin: 4px; border-radius: 50%; background: #3d5afe; box-shadow: 0 0 0 4px rgba(61,90,254,0.25); animation: pulse 1.3s ease-in-out infinite; }
      .found { border-bottom: 1px solid #24272e; min-height: 1px; }
      .found li { display: flex; gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid #24272e; font-size: 15px; }
      .dot { flex: none; width: 10px; height: 10px; background: #d98e04; }
      [data-level="risk"] > .dot { background: #c8352b; }
      .headline { margin: 0; font-size: clamp(2rem, 6vw, 2.8rem); line-height: 1.05; font-weight: 500; letter-spacing: -0.03em; }
      .sub { margin: 0; font-size: 18px; line-height: 1.45; color: #cdd2da; }
      .strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px 16px; }
      .strip li { display: flex; flex-direction: column; gap: 8px; }
      .tick { display: block; height: 8px; background: #d98e04; }
      [data-level="risk"] > .tick { background: #c8352b; }
      [data-level="good"] > .tick { background: #7dd98a; }
      .lv { font-size: 15px; font-weight: 500; }
      .again { align-self: flex-start; padding: 0; background: none; border: 0; border-bottom: 1px solid #4a505a; color: #dce2ff; font: inherit; font-size: 15px; cursor: pointer; }
      @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.7); } }
      @keyframes sweep { 0% { transform: translateX(-120%); } 100% { transform: translateX(420%); } }
      @media (prefers-reduced-motion: reduce) { .sweep, .pulse { animation: none; } .fill { transition: none; } }
      @media (max-width: 480px) { .panel { padding: 24px; } .strip { grid-template-columns: repeat(2, 1fr); } body { padding: 0; } }
    </style>
  </body>
</html>
